# Preview-Domain nicht indexieren (Duplicate Content zu lokalbesucher.de)
https://lokalbesucher-website.pages.dev/*
  X-Robots-Tag: noindex

https://*.lokalbesucher-website.pages.dev/*
  X-Robots-Tag: noindex

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block

# cookie-consent.js: short cache so consent-mode fixes propagate quickly
/assets/js/cookie-consent.js
  Cache-Control: public, max-age=300, must-revalidate

# CSS/JS haben KEINE Fingerprints im Dateinamen — mit "immutable" haetten
# wiederkehrende Besucher Fixes bis zu einem Jahr lang nicht gesehen.
# stale-while-revalidate liefert weiter sofort aus dem Cache und holt die
# neue Fassung im Hintergrund: kein Tempoverlust, aber Aenderungen kommen an.
/assets/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Bilder und Fonts aendern sich nur mit neuem Dateinamen -> weiter immutable
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
